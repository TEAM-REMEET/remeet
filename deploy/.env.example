# 이 파일을 복사해 deploy/.env 로 만들고 값을 채우세요. (.env 는 Git에 올리지 않음)
#   cp .env.example .env

# LLM (요약 · 액션 아이템 추출은 OPENAI_MODEL이 있어야 실행됨)
OPENAI_API_KEY=
OPENAI_MODEL=

# LangSmith 기록 (선택) — 실명 · 직무 · 발화가 외부로 전송되므로 기본은 꺼짐, 켜려면 아래 두 값을 설정
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=

# Neo4j (AuraDB Free)
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
